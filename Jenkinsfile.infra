// Terraform runs as terraform-encounter-platform-deployer, assumed from the
// Jenkins EC2 instance role (infra/ci). The profile file holds only a role ARN,
// never a key; the SDK fetches short-lived credentials from instance metadata.
def terraformAwsEnv() {
  return [
    "AWS_CONFIG_FILE=${env.WORKSPACE}/.aws-terraform.config",
    "AWS_PROFILE=terraform-deployer",
    "AWS_SDK_LOAD_CONFIG=1"
  ]
}

pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '10'))
  }

  parameters {
    choice(
      name: 'ENVIRONMENT',
      choices: ['dev', 'staging', 'prod'],
      description: 'Target environment to plan/apply infrastructure for'
    )
    choice(
      name: 'ACTION',
      choices: ['apply', 'destroy'],
      description: 'apply creates/updates; destroy tears the environment down (prod is refused)'
    )
    string(
      name: 'IMAGE_TAG',
      defaultValue: 'bootstrap',
      description: 'Immutable image tag used only when the ECS service is first created (later rollouts go through Jenkinsfile)'
    )
  }

  environment {
    AWS_REGION        = 'us-east-1'
    INFRA_DIR         = 'infra'
    TF_IN_AUTOMATION  = 'true'
    JENKINS_ROLE_NAME = 'jenkins-encounter-platform-ci'
    TF_ROLE_NAME      = 'terraform-encounter-platform-deployer'
  }

  stages {
    stage('Guard') {
      steps {
        script {
          if (params.ACTION == 'destroy' && params.ENVIRONMENT == 'prod') {
            error('Refusing to destroy prod from the pipeline')
          }
        }
      }
    }

    stage('Assume Terraform Role') {
      steps {
        sh '''
          ./cicd/jenkins/verify-aws-identity.sh "$JENKINS_ROLE_NAME"

          ACCOUNT=$(aws sts get-caller-identity --query Account --output text)
          printf '[profile terraform-deployer]\nrole_arn = arn:aws:iam::%s:role/%s\ncredential_source = Ec2InstanceMetadata\nrole_session_name = jenkins-infra-%s-%s\nregion = %s\n' \
            "$ACCOUNT" "$TF_ROLE_NAME" "$ENVIRONMENT" "$BUILD_NUMBER" "$AWS_REGION" \
            > "$WORKSPACE/.aws-terraform.config"

          AWS_CONFIG_FILE="$WORKSPACE/.aws-terraform.config" AWS_PROFILE=terraform-deployer \
            ./cicd/jenkins/verify-aws-identity.sh "$TF_ROLE_NAME"
        '''
      }
    }

    stage('Terraform Init') {
      steps {
        withEnv(terraformAwsEnv()) {
          withCredentials([string(credentialsId: 'db-password', variable: 'TF_VAR_db_password')]) {
            dir("${INFRA_DIR}") {
              sh '''
                terraform init -input=false -reconfigure \
                  -backend-config="key=env/$ENVIRONMENT/terraform.tfstate"
              '''
            }
          }
        }
      }
    }

    stage('Terraform Validate') {
      steps {
        dir("${INFRA_DIR}") {
          sh 'terraform validate'
        }
      }
    }

    stage('Terraform Plan') {
      steps {
        withEnv(terraformAwsEnv()) {
          withCredentials([string(credentialsId: 'db-password', variable: 'TF_VAR_db_password')]) {
            dir("${INFRA_DIR}") {
              sh '''
                DESTROY_FLAG=""
                [ "$ACTION" = destroy ] && DESTROY_FLAG="-destroy"
                terraform plan -input=false -no-color $DESTROY_FLAG -out=tfplan \
                  -var-file="environments/$ENVIRONMENT.tfvars" \
                  -var="environment=$ENVIRONMENT" \
                  -var="image_tag=$IMAGE_TAG"
                terraform show -no-color tfplan > tfplan.txt
              '''
            }
          }
        }
      }
    }

    stage('Manual Approval') {
      options {
        timeout(time: 2, unit: 'HOURS')
      }
      steps {
        input message: "Review the Terraform ${params.ACTION} plan for ${params.ENVIRONMENT}. Approve?",
              ok: "Run terraform ${params.ACTION}"
      }
    }

    stage('Terraform Apply') {
      steps {
        withEnv(terraformAwsEnv()) {
          withCredentials([string(credentialsId: 'db-password', variable: 'TF_VAR_db_password')]) {
            dir("${INFRA_DIR}") {
              sh 'terraform apply -input=false -no-color tfplan'
            }
          }
        }
      }
    }

    stage('Capture Outputs') {
      steps {
        withEnv(terraformAwsEnv()) {
          dir("${INFRA_DIR}") {
            sh '''
              mkdir -p ../docs/evidence
              cp tfplan.txt "../docs/evidence/tf-$ACTION-plan-$ENVIRONMENT-build-$BUILD_NUMBER.txt"
              terraform output -json > "../docs/evidence/tf-outputs-$ENVIRONMENT-build-$BUILD_NUMBER.json"
            '''
          }
        }
      }
    }
  }

  post {
    always {
      archiveArtifacts artifacts: 'docs/evidence/tf-*', allowEmptyArchive: true, fingerprint: true
      sh 'rm -f "$WORKSPACE/.aws-terraform.config"'
    }
    success {
      echo "Terraform ${params.ACTION} completed for ${params.ENVIRONMENT}."
    }
    failure {
      echo "Infrastructure pipeline failed for ${params.ENVIRONMENT}. Check logs."
    }
  }
}
