pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '10'))
  }

  parameters {
    choice(
      name: 'ENVIRONMENT',
      choices: ['dev', 'staging', 'prod'],
      description: 'Target environment to plan/apply infrastructure for'
    )
    choice(
      name: 'ACTION',
      choices: ['apply', 'destroy'],
      description: 'apply creates/updates; destroy tears the environment down (prod is refused)'
    )
    string(
      name: 'IMAGE_TAG',
      defaultValue: 'bootstrap',
      description: 'Immutable image tag used only when the ECS service is first created (later rollouts go through Jenkinsfile)'
    )
  }

  environment {
    AWS_REGION = 'us-east-1'
    INFRA_DIR  = 'infra'
    TF_IN_AUTOMATION = 'true'
  }

  stages {
    stage('Guard') {
      steps {
        script {
          if (params.ACTION == 'destroy' && params.ENVIRONMENT == 'prod') {
            error('Refusing to destroy prod from the pipeline')
          }
        }
      }
    }

    stage('Terraform Init') {
      steps {
        withCredentials([
          [$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-credentials'],
          string(credentialsId: 'db-password', variable: 'TF_VAR_db_password')
        ]) {
          dir("${INFRA_DIR}") {
            sh '''
              terraform init -input=false -reconfigure \
                -backend-config="key=env/$ENVIRONMENT/terraform.tfstate"
            '''
          }
        }
      }
    }

    stage('Terraform Validate') {
      steps {
        dir("${INFRA_DIR}") {
          sh 'terraform validate'
        }
      }
    }

    stage('Terraform Plan') {
      steps {
        withCredentials([
          [$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-credentials'],
          string(credentialsId: 'db-password', variable: 'TF_VAR_db_password')
        ]) {
          dir("${INFRA_DIR}") {
            sh '''
              DESTROY_FLAG=""
              [ "$ACTION" = destroy ] && DESTROY_FLAG="-destroy"
              terraform plan -input=false -no-color $DESTROY_FLAG -out=tfplan \
                -var-file="environments/$ENVIRONMENT.tfvars" \
                -var="environment=$ENVIRONMENT" \
                -var="image_tag=$IMAGE_TAG"
              terraform show -no-color tfplan > tfplan.txt
            '''
          }
        }
      }
    }

    stage('Manual Approval') {
      options {
        timeout(time: 2, unit: 'HOURS')
      }
      steps {
        input message: "Review the Terraform ${params.ACTION} plan for ${params.ENVIRONMENT}. Approve?",
              ok: "Run terraform ${params.ACTION}"
      }
    }

    stage('Terraform Apply') {
      steps {
        withCredentials([
          [$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-credentials'],
          string(credentialsId: 'db-password', variable: 'TF_VAR_db_password')
        ]) {
          dir("${INFRA_DIR}") {
            sh 'terraform apply -input=false -no-color tfplan'
          }
        }
      }
    }

    stage('Capture Outputs') {
      steps {
        withCredentials([
          [$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-credentials']
        ]) {
          dir("${INFRA_DIR}") {
            sh '''
              mkdir -p ../docs/evidence
              cp tfplan.txt "../docs/evidence/tf-$ACTION-plan-$ENVIRONMENT-build-$BUILD_NUMBER.txt"
              terraform output -json > "../docs/evidence/tf-outputs-$ENVIRONMENT-build-$BUILD_NUMBER.json"
            '''
          }
        }
      }
    }
  }

  post {
    always {
      archiveArtifacts artifacts: 'docs/evidence/tf-*', allowEmptyArchive: true, fingerprint: true
    }
    success {
      echo "Terraform ${params.ACTION} completed for ${params.ENVIRONMENT}."
    }
    failure {
      echo "Infrastructure pipeline failed for ${params.ENVIRONMENT}. Check logs."
    }
  }
}
